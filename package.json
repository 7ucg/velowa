{
	"name": "velowa",
	"version": "0.0.0",
	"description": "WhatsApp Web multi-device client library — TypeScript, with libsignal/WABinary/Noise/app-state crypto ported to Rust and compiled to WASM",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"license": "MIT",
	"scripts": {
		"build:wasm": "wasm-pack build rust/wasm-bridge --target web --out-dir ../../src/wasm",
		"build": "npm run build:wasm && tsc -p tsconfig.json",
		"lint": "tsc --noEmit && eslint src --ext .ts",
		"test": "jest --runInBand"
	},
	"devDependencies": {
		"@types/jest": "^30.0.0",
		"@types/node": "^22.0.0",
		"@typescript-eslint/eslint-plugin": "^8.68.0",
		"@typescript-eslint/parser": "^8.68.0",
		"eslint": "^9",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.4.1",
		"jest": "^30.5.0",
		"ts-jest": "^29.4.11",
		"prettier": "^3.5.3",
		"typescript": "^5.9.3",
		"protobufjs-cli": "^1.3.1"
	},
	"dependencies": {
		"protobufjs": "^7.6.1"
	}
}
