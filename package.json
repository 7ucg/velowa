{
	"name": "velowa",
	"version": "0.0.0",
	"description": "WhatsApp Web multi-device client library — TypeScript, with libsignal/WABinary/Noise/app-state crypto ported to Rust and compiled to WASM",
	"type": "module",
	"main": "./dist/index.cjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"engines": {
		"node": ">=18"
	},
	"license": "SEE LICENSE IN LICENSE",
	"scripts": {
		"build:wasm": "wasm-pack build rust/wasm-bridge --target web --out-dir ../../src/wasm",
		"build": "npm run build:wasm && npm run build:wasm-voip && npm run build:js",
		"typecheck": "tsc --noEmit",
		"lint": "tsc --noEmit && eslint src tests",
		"format": "prettier --write src tests",
		"test": "vitest run",
		"prepack": "npm run build",
		"pair": "npm run build:js && node dist/cli/pair.js",
		"example": "npm run build:js && node examples/tour.js",
		"build:wasm-voip": "wasm-pack build rust/wasm-voip --target web --out-dir ../../src/wasm-voip",
		"check:package": "publint && attw --pack . --profile node16 && vitest run tests/package",
		"build:js": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup && node scripts/copy-assets.mjs",
		"logs": "tsup && node scripts/copy-assets.mjs && node dist/cli/logs.js",
		"check:docs": "vitest run tests/docs"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@types/node": "^22.0.0",
		"@types/qrcode-terminal": "^0.12.2",
		"@types/ws": "^8.18.2",
		"eslint": "^10",
		"eslint-config-prettier": "^10.1.8",
		"prettier": "^3.5.3",
		"publint": "^0.3.25",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.68.0",
		"vitest": "^3.2.0"
	},
	"dependencies": {
		"opusscript": "^0.1.1",
		"protobufjs": "^7.6.1",
		"ws": "^8.22.1"
	},
	"files": [
		"dist",
		"LICENSE",
		"THIRD_PARTY_NOTICES.md",
		"README.md"
	],
	"keywords": [
		"whatsapp",
		"whatsapp-web",
		"wasm",
		"signal-protocol",
		"typescript"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/7ucg/velowa.git"
	},
	"sideEffects": false,
	"module": "./dist/index.js",
	"optionalDependencies": {
		"qrcode-terminal": "^0.12.0"
	},
	"bin": {
		"velowa-pair": "./dist/cli/pair.js",
		"velowa-logs": "./dist/cli/logs.js"
	},
	"bugs": {
		"url": "https://github.com/7ucg/velowa/issues"
	},
	"homepage": "https://github.com/7ucg/velowa#readme",
	"private": true
}
