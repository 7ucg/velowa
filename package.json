{
	"name": "velowa",
	"version": "0.0.0",
	"description": "WhatsApp Web multi-device client library — TypeScript, with libsignal/WABinary/Noise/app-state crypto ported to Rust and compiled to WASM",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"engines": {
		"node": ">=18"
	},
	"license": "MIT",
	"scripts": {
		"build:wasm": "wasm-pack build rust/wasm-bridge --target web --out-dir ../../src/wasm",
		"build": "npm run build:wasm && tsc -p tsconfig.json && rm -rf dist/wasm && cp -r src/wasm dist/wasm && rm -f dist/wasm/.gitignore dist/wasm/package.json",
		"typecheck": "tsc --noEmit",
		"lint": "tsc --noEmit && eslint src",
		"format": "prettier --write src",
		"test": "vitest run",
		"prepack": "npm run build"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"eslint": "^9",
		"eslint-config-prettier": "^10.1.8",
		"prettier": "^3.5.3",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.68.0",
		"vitest": "^3.2.0"
	},
	"dependencies": {
		"protobufjs": "^7.6.1"
	},
	"files": [
		"dist",
		"LICENSE",
		"README.md"
	],
	"keywords": [
		"whatsapp",
		"whatsapp-web",
		"wasm",
		"signal-protocol",
		"typescript"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/7ucg/velowa.git"
	},
	"sideEffects": false
}
